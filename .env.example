# c7-backend environment. Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=4000
# NEW database only (never the existing "fit-forge" DB). db:setup creates it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/c7_mobile
# Same Clerk instance as FitForge so web + mobile sessions are accepted.
AUTH_MODE=clerk
CLERK_SECRET_KEY=sk_live_xxx
# Browser origins allowed to call the API (mobile native apps send no Origin).
CORS_ORIGINS=https://staging.c7personalfitness.com,http://localhost:8081
# FitForge origin that serves exercise images from /public.
WEB_ASSET_BASE_URL=https://staging.c7personalfitness.com
# First sign-in with this email becomes SUPER_ADMIN (when no invitation exists).
SUPER_ADMIN_EMAIL=
MAX_UPLOAD_BYTES=5242880
